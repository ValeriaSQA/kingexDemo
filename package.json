{
  "name": "kingexdemo",
  "version": "1.0.0",
  "description": "Kingex sign-in E2E demo with Playwright, TypeScript and cross-browser checks",
  "scripts": {
    "test": "playwright test",
    "test:list": "playwright test --list",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "test:signIn:chrome": "playwright test --project=chromium --grep @signIn",
    "test:signIn:firefox": "playwright test --project=firefox --grep @signIn",
    "test:signIn:webkit": "playwright test --project=webkit --grep @signIn"
  },
  "keywords": [
    "playwright",
    "typescript",
    "e2e",
    "kingex"
  ],
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "dotenv": "^16.6.1",
    "typescript": "~5.9.3"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
