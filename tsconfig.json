{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@pageObjects/*": [
        "./pageObjects/*"
      ]
    },
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "playwright.config.ts",
    "global-setup.ts",
    "pageObjects/**/*.ts",
    "tests/**/*.ts"
  ]
}
